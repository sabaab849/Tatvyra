# Razorpay keys — read only by the server functions in api/razorpay/.
# Copy this file to .env.local (git-ignored) for local development, and set the
# same two variables in Vercel → Project → Settings → Environment Variables.
# Never prefix these with VITE_: that would ship the secret to every browser.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Shiprocket — paid orders are created in Shiprocket automatically once the
# email and password are set (see api/_lib/shiprocket.js). Leave blank to
# switch it off. SHIPROCKET_EMAIL is an API user (Shiprocket → Settings → API),
# not the main login. SHIPROCKET_PICKUP is optional: the pickup location name,
# exactly as saved; left blank, the account's primary pickup address is used.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP=
